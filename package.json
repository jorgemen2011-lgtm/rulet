{
  "name": "rulet",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @rulet/api dev",
    "dev:mobile": "pnpm --filter @rulet/mobile start",
    "dev:web": "pnpm --filter @rulet/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
