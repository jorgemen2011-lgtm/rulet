# Variables de `docker compose` (docker-compose.yml de la raíz). Copia este archivo a `.env` en la raíz:
#
#   cp .env.example .env
#
# Compose lee `.env` automáticamente para sustituir las ${VARIABLES} de docker-compose.yml. El `.env` no se
# versiona (.gitignore) ni entra en el contexto de build de las imágenes (.dockerignore).
# Para desarrollar sin Docker, cada app tiene su propio .env.example (p. ej. apps/api/.env.example).

# Obligatoria: secreto para firmar los access tokens JWT (≥ 32 caracteres). La API de compose arranca con
# NODE_ENV=production y rechaza valores de ejemplo, así que genera uno propio y pégalo aquí:
#
#   openssl rand -base64 48
#
# Es solo para tu máquina: no lo reutilices en ningún otro entorno.
JWT_ACCESS_SECRET=
