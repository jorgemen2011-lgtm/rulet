{
  "name": "@rulet/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@rulet/shared": "workspace:*",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@rulet/eslint-config": "workspace:*",
    "@rulet/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.12.0",
    "supertest": "^7.0.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2"
  },
  "files": [
    "dist"
  ],
  "type": "module"
}
