# Copia a .env. Todas las variables se validan en src/config/env.ts: si alguna es inválida, la API no arranca.
# Los valores de este archivo son de EJEMPLO para desarrollo local. Nunca pongas secretos reales aquí.

NODE_ENV=development
PORT=3000
APP_VERSION=0.0.0

# Orígenes permitidos por CORS (web), separados por comas. Formato exacto esquema://host[:puerto], sin barra final.
# Sin valor: http://localhost:3001 fuera de producción. En producción es OBLIGATORIA, solo https:// y nunca "*"
# ni localhost (salvo ALLOW_LOCALHOST_CORS=true).
CORS_ORIGINS=http://localhost:3001
# Solo para docker compose local (NODE_ENV=production en http://localhost). Nunca en un despliegue real.
ALLOW_LOCALHOST_CORS=false

# Proxies de confianza para obtener la IP real del cliente de X-Forwarded-For (clave del rate limiting).
# Valores: número de proxies delante de la API (p. ej. 1 tras un único balanceador; 2 con CDN + balanceador),
# lista de IP/CIDR de los proxies separadas por comas (se admiten loopback, linklocal, uniquelocal), o
# false si la API recibe tráfico directo (nunca la expongas sin proxy con un valor distinto de false).
# Sin valor: loopback fuera de producción. En producción es OBLIGATORIA (sin valor por defecto).
TRUST_PROXY=loopback

# Rate limiting global por IP (auth tiene además límites propios más estrictos, y login uno por cuenta:
# 10 intentos cada 15 min). Contadores en memoria: con varias réplicas, cada una cuenta por separado.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Base de datos (PostgreSQL) ---
# Obligatoria. Credenciales de la BD local de desarrollo (docker compose / Postgres local).
# No pongas parámetros TLS en la URL (sslmode, ssl, uselibpqcompat…): pg los aplica por encima de DATABASE_SSL
# y podrían desactivar TLS en silencio, así que se rechazan. Solo se admiten sslmode=verify-full, sslrootcert,
# sslcert y sslkey, y siempre con DATABASE_SSL=true.
DATABASE_URL=postgres://rulet:rulet@localhost:5432/rulet
# TLS hacia la BD (verifica el certificado). En producción es obligatorio salvo DATABASE_SSL_ALLOW_INSECURE=true.
DATABASE_SSL=false
# Solo para producción sin TLS en una red privada de confianza (p. ej. docker compose local). Evítalo.
DATABASE_SSL_ALLOW_INSECURE=false
# Conexiones máximas del pool por instancia de la API.
DATABASE_POOL_MAX=10

# --- Autenticación ---
# Obligatoria, mínimo 32 caracteres. Genera una propia con:  openssl rand -base64 48
# Este valor es un marcador: cámbialo incluso en desarrollo y usa uno distinto por entorno.
# En producción se rechazan los secretos de ejemplo o de desarrollo (los que contienen insecure, not-a-secret,
# dev-only, devcontainer, test-only, cambia-esto o change-me).
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-generado-con-openssl-rand
JWT_ISSUER=rulet-api
JWT_AUDIENCE=rulet-clients
# Cookies web con Secure y prefijos __Host-/__Secure- (requiere HTTPS). Por defecto: true si NODE_ENV=production.
COOKIE_SECURE=false
