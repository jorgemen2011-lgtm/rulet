# Origen de la API, sin versión (el cliente añade /v1). Se incrusta en el build: es PÚBLICA, nunca pongas secretos.
# En producción debe ser https:// (solo se tolera http:// hacia localhost para builds locales y docker compose).
# Se usa también en la CSP (connect-src), así que debe ser exactamente el origen al que llama el navegador.
NEXT_PUBLIC_API_URL=http://localhost:3000
