// Entorno de desarrollo completo (Node 24 + pnpm + PostgreSQL 17) para GitHub Codespaces y Dev Containers.
//
// Uso:
//   - Codespaces: en GitHub, Code → Codespaces → "Create codespace on main".
//   - Local: VS Code con la extensión "Dev Containers" → "Reopen in Container".
// Al crearse instala dependencias, genera los .env que falten a partir de los .env.example y aplica las
// migraciones a la BD `rulet` (los e2e usan `rulet_test`, que también se crea). Después: `pnpm dev`.
//
// La web autentica con cookies `SameSite`, que solo viajan si web y API comparten site. Las URLs públicas
// de Codespaces (*.app.github.dev) son sites distintos, así que abre el codespace desde VS Code (los puertos
// se reenvían a localhost) o usa `gh codespace ports forward 3000:3000 3001:3001`.
{
  "name": "Rulet",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [3000, 3001, 5432],
  "portsAttributes": {
    "3000": { "label": "API", "onAutoForward": "notify" },
    "3001": { "label": "Web", "onAutoForward": "openBrowser" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "8081": { "label": "Expo (Metro)", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "expo.vscode-expo-tools"]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
